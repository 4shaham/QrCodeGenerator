<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>500 Server Error</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="text-center">
            <div class="mb-4">
                <i class="fas fa-exclamation-circle text-danger" style="font-size: 5rem;"></i>
            </div>
            
            <h1 class="display-4 fw-bold mb-4">500 Server Error</h1>
            
            <div class="mb-4">
                <p class="lead text-secondary">
                    Oops! Something went wrong on our end.
                </p>
                <p class="text-muted">
                    Our team has been notified and is working to fix the issue.
                </p>
            </div>
            
            <div class="card bg-white shadow-sm p-4 mb-4">
                <h5 class="card-title mb-3">You can try:</h5>
                <ul class="list-unstyled text-start">
                    <li class="mb-2">
                        <i class="fas fa-redo me-2 text-primary"></i>
                        Refreshing the page
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-clock me-2 text-primary"></i>
                        Coming back in a few minutes
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-trash me-2 text-primary"></i>
                        Clearing your browser cache
                    </li>
                </ul>
            </div>
            
            <button 
                onclick="window.location.reload()" 
                class="btn btn-primary btn-lg px-5 mb-4"
            >
                <i class="fas fa-redo me-2"></i>
                Refresh Page
            </button>
            
            <p class="text-muted small">
                If the problem persists, please contact our support team.
            </p>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>