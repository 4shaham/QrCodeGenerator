<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Header -->
    <%-include("navbar")-%>

    <!-- Main Content -->
    <main class="container my-5">
      <section id="login" class="">
        <h2 class="h4 text-center mb-4">Dashboard</h2>
        <div class="d-flex justify-content-end mb-3">
          <button class="btn btn-success" id="QrBtn">Generate QR Code</button>
        </div>
        <table class="table table-striped table-bordered">
          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Voucher Number</th>
              <th>Generated Date</th>
              <th>Expiry Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
           <% for(let i=0;i<vouchers.length;i++) { %>
            <tr>
              <td><%=i+1 %></td>
              <td>1234567890</td>
              <td>2025-01-10</td>
              <td>2025-01-20</td>
              <td>
                <button
                  class="btn btn-primary btn-sm"
                  value=<%=i%>
                  id="exportAsPdfBtn"
                >
                  Export As Pdf
                </button>
                <button class="btn btn-secondary btn-sm">Print</button>
              </td>
            </tr>
           <% } %> 
            <!-- More rows as needed -->
          </tbody>
        </table>
      </section>
    </main>

    <!-- Footer -->
    <!-- <footer class="bg-light text-center py-3">
    <p class="mb-0">© 2025 QR Voucher System. All rights reserved.</p>
  </footer> -->

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>

  <script>
    const QrBtn = document.getElementById("QrBtn");
    const exportAsPdfButtons = document.querySelectorAll("#exportAsPdfBtn"); // Select all export buttons
  
    // QR Code generation logic
    QrBtn.addEventListener("click", async () => {
      try {
        const postData = {
          username: "exampleUser",  
          email: "user@example.com",
        };
  
        const requestOptions = {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(postData),
        };
  
        const response = await fetch("http://localhost:4005/api/createQR", requestOptions);
  
        if (response.ok) {
          const data = await response.json(); // Parse the JSON response
          alert("Successfully created QR code!");
          console.log(data);
  
          // Check if data contains the QR code image
          const qrCodeImage = data.data; // Base64 QR code image
  
          // Display the QR code image in the HTML
          const imgElement = document.createElement("img");
          imgElement.src = qrCodeImage; // Set the source of the image
          document.body.appendChild(imgElement); // Append the image to the body or a specific element
        } else {
          console.error("Error generating QR code");
        }
      } catch (error) {
        console.error("Error fetching QR code:", error);
      }
    });
  
    // Add event listeners to all "Export As PDF" buttons
    exportAsPdfButtons.forEach((button) => {
      button.addEventListener("click", async (event) => {
        const voucherIndex = event.target.value; // Get the value (voucher index) from the button
        console.log(`Exporting voucher at index: ${voucherIndex}`);
  
        try {

          // Fetch voucher data and generate PDF
          const response = await fetch(`http://localhost:4005/api/generate-pdf?voucherIndex=${voucherIndex}`);
  
          if (response.ok) {
            const blob = await response.blob(); // Get the PDF as a blob
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `voucher_${voucherIndex}.pdf`; // Name the PDF file
            document.body.appendChild(a);
            a.click();
            a.remove();
          } else {
            console.error("Error generating PDF");
          }
          
        } catch (error) {
          console.error("Error exporting voucher as PDF:", error);
        }
      });
    });
  </script>
  
</html>
