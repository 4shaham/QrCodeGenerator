<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="text-center">
            <h1 class="display-1 fw-bold text-primary">404</h1>
            <div class="mb-4">
                <div class="display-6 text-muted mb-3">Page Not Found</div>
                <p class="lead mb-4">Oops! The page you're looking for doesn't exist.</p>
            </div>
            <div>
                <a href="/api/" class="btn btn-primary btn-lg px-4 me-3">Go Home</a>
                <button onclick="history.back()" class="btn btn-outline-secondary btn-lg px-4">Go Back</button>
            </div>
            <p class="mt-4 text-muted">If you believe this is a mistake, please contact our support team.</p>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>

